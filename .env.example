# Proveedor del modelo: anthropic | gemini (plan gratuito) | compatible (Groq, Ollama…) | simulado (sin clave)
LLM_PROVIDER=anthropic
# Clave del modelo. Solo en el backend; nunca en el repositorio ni en el front.
ANTHROPIC_API_KEY=
# Gemini gratis: clave en https://aistudio.google.com (sin tarjeta)
GEMINI_API_KEY=
# Proveedor compatible con OpenAI (Groq, Ollama…): URL base y clave
LLM_BASE_URL=
LLM_API_KEY=
# Modelo (vacío = el del proveedor: claude-opus-5-5 / gemini-flash-latest) y esfuerzo de Claude
LLM_MODEL=
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_MS=90000

# Límites de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
MAX_TOKENS_GLOBAL=3000000

# Servidor
PORT=3000
# Opcional: si se define, el chat pide esta clave (cabecera x-access-key)
ACCESS_KEY=

# Para integraciones sin servidor (modulo/): false = confiar en confirmado=true
OC_CONFIRMACION_ESTRICTA=true
